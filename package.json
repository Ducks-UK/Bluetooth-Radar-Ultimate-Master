"build": {
  "appId": "uk.ducks.bluetoothradar",
  "productName": "Bluetooth Radar",
  "copyright": "Copyright © 2026 Ducks_UK",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": "nsis",
    "artifactName": "Bluetooth-Radar-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
